@model IEnumerable<AIEnterpriseCommandCenter.Application.DTOs.User.UserDto>

@{
    ViewData["Title"] = "User Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>

        <h2 class="fw-bold mb-1">
            User Management
        </h2>

        <p class="text-muted mb-0">
            Manage application users, roles and account status.
        </p>

    </div>

    <a asp-action="Create"
       class="btn btn-primary">

        <i class="bi bi-person-plus-fill me-2"></i>

        Create User

    </a>

</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">

        @TempData["Success"]

        <button class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}

<div class="card shadow-sm border-0 rounded-4">

    <div class="card-body">

        <div class="row mb-3">

            <div class="col-md-4">

                <input id="searchUser"
                       class="form-control"
                       placeholder="Search user..." />

            </div>

        </div>

        <div class="table-responsive">

            <table class="table table-hover align-middle"
                   id="userTable">

                <thead class="table-light">

                    <tr>

                        <th>Name</th>

                        <th>Email</th>

                        <th>Role</th>

                        <th>Department</th>

                        <th>Status</th>

                        <th>Created</th>

                        <th class="text-center">
                            Actions
                        </th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>

                                <strong>
                                    @item.FullName
                                </strong>

                                <br />

                                <small class="text-muted">
                                    @item.EmployeeCode
                                </small>

                            </td>

                            <td>
                                @item.Email
                            </td>

                            <td>

                                <span class="badge bg-primary">

                                    @item.Role

                                </span>

                            </td>

                            <td>

                                @item.Department

                            </td>

                            <td>

                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">

                                        Active

                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">

                                        Inactive

                                    </span>
                                }

                            </td>

                            <td>

                                @item.CreatedOn.ToString("dd MMM yyyy")

                            </td>

                            <td class="text-center">

                                <a asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn btn-warning btn-sm">

                                    <i class="bi bi-pencil-square"></i>

                                </a>

                                <form asp-action="ResetPassword"
                                      method="post"
                                      class="d-inline">

                                    <input type="hidden"
                                           name="id"
                                           value="@item.Id" />

                                    <button class="btn btn-info btn-sm"
                                            onclick="return confirm('Reset password to Welcome@123 ?')">

                                        <i class="bi bi-key-fill"></i>

                                    </button>

                                </form>

                                <form asp-action="ChangeStatus"
                                      method="post"
                                      class="d-inline">

                                    <input type="hidden"
                                           name="id"
                                           value="@item.Id" />

                                    <input type="hidden"
                                           name="isActive"
                                           value="@(!item.IsActive)" />

                                    @if (item.IsActive)
                                    {
                                        <button class="btn btn-danger btn-sm">

                                            <i class="bi bi-person-x-fill"></i>

                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-success btn-sm">

                                            <i class="bi bi-person-check-fill"></i>

                                        </button>
                                    }

                                </form>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

@section Scripts {

    <script>

        document
        .getElementById("searchUser")
        .addEventListener("keyup",function(){

            let value=this.value.toLowerCase();

            let rows=document.querySelectorAll("#userTable tbody tr");

            rows.forEach(function(row){

                row.style.display=
                row.innerText.toLowerCase().includes(value)
                ? ""
                : "none";

            });

        });

    </script>

}