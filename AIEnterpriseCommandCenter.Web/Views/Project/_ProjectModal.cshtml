

@model AIEnterpriseCommandCenter.Application.DTOs.Project.ProjectDto

<div class="modal fade" id="projectModal" tabindex="-1">

    <div class="modal-dialog modal-dialog-centered modal-md" style="max-width:650px;">

        <div class="modal-content project-modal">

            <!-- Header -->

            <div class="modal-header border-0 pb-2">

                <div>
                    <h5 class="modal-title fw-bold text-white mb-1">
                        @Model.ProjectName
                    </h5>

                    <small class="text-secondary">
                        @Model.ProjectCode
                    </small>
                </div>

                <div class="d-flex align-items-center gap-2 ms-auto">

                    <!-- Priority -->
                    @{
                        string priorityClass = Model.Priority.ToString() switch
                        {
                            "Low" => "priority-low",
                            "Medium" => "priority-medium",
                            "High" => "priority-high",
                            "Critical" => "priority-critical",
                            _ => "priority-medium"
                        };
                    }

                    <span class="@priorityClass">

                        @Model.Priority Priority

                    </span>

                    @{
                        string statusClass = Model.Status.ToString() switch
                        {
                            "Planning" => "status-planning",
                            "Active" => "status-active",
                            "Completed" => "status-completed",
                            "OnHold" => "status-hold",
                            _ => "status-default"
                        };
                    }

                    <span class="@statusClass">

                        @Model.Status

                    </span>

                    <button type="button"
                            class="btn-close btn-close-white ms-2"
                            data-bs-dismiss="modal">
                    </button>

                </div>

            </div>
            <!-- Body -->

            <div class="modal-body">

                <!-- Description -->

                <div class="description-box mb-4">

                    <div class="small text-uppercase text-secondary mb-2">
                        Description
                    </div>

                    <div class="text-light">

                        @Model.Description

                    </div>

                </div>

                

                <div class="row g-3 mb-4">

                    <div class="col-md-4">

                        <div class="info-card">

                            <i class="bi bi-person-fill"></i>

                            <div>

                                <small>Manager</small>

                                <h6>@Model.ManagerName</h6>

                            </div>

                        </div>

                    </div>

                    <div class="col-md-4">

                        <div class="info-card">

                            <i class="bi bi-people-fill"></i>

                            <div>

                                <small>Members</small>

                                <h6>@Model.TeamMembers</h6>

                            </div>

                        </div>

                    </div>

                   

                </div>

                
                <div class="mb-4">

                    <div class="d-flex justify-content-between">

                        <strong class="text-light">

                            Progress

                        </strong>

                        <strong class="text-info">

                            @Model.Progress%

                        </strong>

                    </div>

                    <div class="progress project-progress mt-2">

                        <div class="progress-bar progress-bar-striped progress-bar-animated"
                             style="width:@Model.Progress%">
                        </div>

                    </div>

                </div>

                <!-- Dates -->

                <div class="row">

                    <div class="col-md-6">

                        <div class="date-card">

                            <i class="bi bi-calendar-event"></i>

                            <div>

                                <small>Start Date</small>

                                <h6>

                                    @Model.StartDate.ToString("dd MMM yyyy")

                                </h6>

                            </div>

                        </div>

                    </div>

                    <div class="col-md-6">

                        <div class="date-card">

                            <i class="bi bi-calendar-check"></i>

                            <div>

                                <small>End Date</small>

                                <h6>

                                    @Model.EndDate.ToString("dd MMM yyyy")

                                </h6>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <!-- Footer -->

            <div class="modal-footer border-0">
                @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                {
                    <a asp-action="Edit"
                    asp-route-id="@Model.Id"
                    class="btn btn-warning btn-sm">

                        <i class="bi bi-pencil-square"></i>

                        Edit

                    </a>
                }
                @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                {
                    <a asp-action="AssignEmployees"
                    asp-route-id="@Model.Id"
                    class="btn btn-info rounded-pill px-3">

                        <i class="bi bi-people me-2"></i>

                        Assign Team

                    </a>
                }

                @if (User.IsInRole("Admin"))
                {
                    <button type="button" class="btn btn-danger btn-sm"
                    onclick="deleteProject(@Model.Id)">

                        <i class="bi bi-trash"></i>

                        Delete

                    </button>
                }


            </div>

        </div>

    </div>

</div>

<style>

    .project-modal {
        background: #0f172a;
        border-radius: 20px;
        border: none;
        color: white;
        overflow: hidden;
        box-shadow: 0 20px 60px rgba(0,0,0,.5);
    }

    .modal-header {
        background: #111827;
        padding: 16px 20px;
    }

    .modal-body {
        padding: 18px 20px;
    }

    .modal-footer {
        background: #111827;
        padding: 14px 20px;
    }

    .description-box {
        background: #1e293b;
        padding: 12px 14px;
        border-radius: 12px;
        font-size: 14px;
    }

    .info-card {
        background: #1e293b;
        padding: 10px 12px;
        border-radius: 12px;
        display: flex;
        gap: 15px;
        align-items: center;
        height: 100%;
    }

        .info-card i {
            font-size: 26px;
            color: #38bdf8;
        }

        .info-card small {
            color: #94a3b8;
        }

        .info-card h6 {
            margin: 0;
            font-weight: 600;
            color: white;
        }

    .date-card {
        background: #1e293b;
        padding: 15px;
        border-radius: 15px;
        display: flex;
        gap: 15px;
        align-items: center;
    }

        .date-card i {
            font-size: 24px;
            color: #22c55e;
        }

        .date-card small {
            color: #94a3b8;
        }

        .date-card h6 {
            margin: 0;
            color: white;
        }

    .project-progress {
        height: 12px;
        background: #334155;
        border-radius: 50px;
        overflow: hidden;
    }

    .progress-bar {
        background: linear-gradient(90deg,#06b6d4,#22c55e);
    }

    .status-badge {
        background: #16a34a;
        padding: 8px 14px;
        font-size: 13px;
        border-radius: 30px;
    }

    .priority-badge {
        background: #f59e0b;
        padding: 8px 15px;
        font-size: 13px;
        border-radius: 30px;
    }

    .btn {
        border-radius: 10px;
        padding: 10px 20px;
    }

    .status-active {
        background: #052e16;
        color: #4ade80;
        border: 1px solid #16a34a;
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

    .status-planning {
        background: #172554;
        color: #60a5fa;
        border: 1px solid #2563eb;
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 12px;
    }

    .status-completed {
        background: #064e3b;
        color: #6ee7b7;
        border: 1px solid #10b981;
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 12px;
    }

    .status-hold {
        background: #451a03;
        color: #fbbf24;
        border: 1px solid #f59e0b;
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 12px;
    }

    .priority-low {
        background: #1f2937;
        color: #9ca3af;
        border: 1px solid #6b7280;
        padding: 5px 12px;
        border-radius: 20px;
    }

    .priority-medium {
        background: #172554;
        color: #60a5fa;
        border: 1px solid #2563eb;
        padding: 5px 12px;
        border-radius: 20px;
    }

    .priority-high {
        background: #451a03;
        color: #fbbf24;
        border: 1px solid #f59e0b;
        padding: 5px 12px;
        border-radius: 20px;
    }

    .priority-critical {
        background: #450a0a;
        color: #f87171;
        border: 1px solid #ef4444;
        padding: 5px 12px;
        border-radius: 20px;
    }
</style>
<script>
    function deleteProject(id) {

        if (confirm("Are you sure you want to delete this project?")) {

            window.location.href = "/Project/Delete/" + id;

        }

    }
</script>
