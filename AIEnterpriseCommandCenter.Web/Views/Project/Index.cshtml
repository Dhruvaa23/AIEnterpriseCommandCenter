@model IEnumerable<AIEnterpriseCommandCenter.Application.DTOs.Project.ProjectDto>

@{
    ViewData["Title"] = "Projects";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2 class="fw-bold mb-1">Project Monitoring</h2>
        <p class="text-muted">
            @Model.Count() Projects
        </p>
    </div>
    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
    {
        <a asp-action="Create" class="btn btn-info text-white px-4">
            <i class="bi bi-plus-lg"></i>
            Create Project
        </a>
    }

</div>

<div class="row">

    @foreach (var project in Model)
    {
        <div class="col-lg-4 mb-4">

            @await Html.PartialAsync("_ProjectCard", project)

        </div>
    }

</div>

<div id="projectModalContainer"></div>

@section Scripts {

    <script>

        function loadProject(id){

            $.get('/Project/Details/' + id,function(result){

                $("#projectModalContainer").html(result);

                var modal = new bootstrap.Modal(
                    document.getElementById('projectModal'));

                modal.show();

            });

        }

    </script>

}