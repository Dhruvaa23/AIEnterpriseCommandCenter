@model AIEnterpriseCommandCenter.Application.DTOs.Project.AssignEmployeeDto

@{
    ViewData["Title"] = "Assign Employees";
    var employees = ViewBag.Employees as IEnumerable<AIEnterpriseCommandCenter.Application.DTOs.Employee.EmployeeDto>;
}

<form asp-action="AssignEmployees" method="post">

    <input asp-for="ProjectId" type="hidden" />

    <div class="container-fluid">

        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">

            <div>

                <h2 class="fw-bold">
                    <i class="bi bi-people-fill text-primary me-2"></i>
                    Assign Team Members
                </h2>

                <p class="text-muted mb-0">
                    @Model.ProjectName
                </p>

            </div>

            <a asp-action="Index"
               class="btn btn-outline-secondary rounded-pill px-4">

                <i class="bi bi-arrow-left me-2"></i>

                Back

            </a>

        </div>


        <div class="row">

            <!-- Employee List -->
            <div class="col-lg-8">

                <div class="card border-0 shadow rounded-4">

                    <div class="card-body p-4">

                        <div class="mb-4">

                            <input type="text"
                                   id="employeeSearch"
                                   class="form-control form-control-lg"
                                   placeholder="🔍 Search employee..." />

                        </div>

                        <div id="employeeList">

                            @foreach (var emp in employees)
                            {
                                <div class="employee-card card border mb-3 shadow-sm">

                                    <div class="card-body">

                                        <div class="d-flex align-items-center">

                                            <input class="form-check-input employee-checkbox me-3"
                                                   type="checkbox"
                                                   name="SelectedEmployeeIds"
                                                   value="@emp.Id"
                                                   @(Model.SelectedEmployeeIds.Contains(emp.Id) ? "checked" : "") />

                                            <div class="flex-grow-1">

                                                <h5 class="mb-1 fw-bold">

                                                    @emp.FullName

                                                </h5>

                                                <div class="text-muted">

                                                    @emp.Department

                                                </div>

                                            </div>

                                            <span class="badge bg-primary">

                                                @emp.Designation

                                            </span>

                                        </div>

                                    </div>

                                </div>
                            }

                        </div>

                    </div>

                </div>

            </div>

            <!-- Summary -->
            <div class="col-lg-4">

                <div class="card border-0 shadow rounded-4 sticky-top">

                    <div class="card-body p-4">

                        <h4 class="fw-bold mb-4">

                            Team Summary

                        </h4>

                        <div class="text-center mb-4">

                            <h1 class="display-4 text-primary"
                                id="selectedCount">

                                @Model.SelectedEmployeeIds.Count

                            </h1>

                            <div class="text-muted">

                                Employees Selected

                            </div>

                        </div>

                        <hr />

                        <div class="d-grid gap-3">

                            <button class="btn btn-primary btn-lg rounded-pill"
                                    type="submit">

                                <i class="bi bi-check-circle me-2"></i>

                                Save Assignment

                            </button>

                            <a asp-action="Index"
                               class="btn btn-outline-secondary rounded-pill">

                                Cancel

                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</form>

@section Scripts {

    <script>

        const search=document.getElementById("employeeSearch");

        search.addEventListener("keyup",function(){

            let filter=this.value.toLowerCase();

            document.querySelectorAll(".employee-card").forEach(card=>{

                card.style.display=
                card.innerText.toLowerCase().includes(filter)
                ?"block":"none";

            });

        });

        function updateCount(){

            let count=document.querySelectorAll(".employee-checkbox:checked").length;

            document.getElementById("selectedCount").innerText=count;

        }

        document.querySelectorAll(".employee-checkbox").forEach(cb=>{

            cb.addEventListener("change",updateCount);

        });

        updateCount();

    </script>

}
<style>
    .employee-card {
        transition: .25s;
        border-radius: 15px;
    }

        .employee-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(0,0,0,.12);
            border-color: #0d6efd;
        }

    .employee-checkbox {
        width: 22px;
        height: 22px;
    }

    .sticky-top {
        top: 90px;
    }
</style>