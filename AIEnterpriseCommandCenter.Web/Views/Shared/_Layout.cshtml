@using Microsoft.AspNetCore.Identity
@using AIEnterpriseCommandCenter.Infrastructure.Identity

@inject UserManager<ApplicationUser> UserManager

@{
    var currentUser = await UserManager.GetUserAsync(User);
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] - AI Enterprise Command Center</title>

    <!-- Google Font -->

    <link rel="preconnect"
          href="https://fonts.googleapis.com">

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
          rel="stylesheet">

    <!-- Bootstrap -->

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.css" />

    <!-- Bootstrap Icons -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Enterprise CSS -->

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/enterprise.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/employee.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/asset.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/project.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/serviced.css"
          asp-append-version="true" />

</head>

<body>

    

        <div class="app-container">

            <!-- ===================== -->
            <!-- Sidebar -->
            <!-- ===================== -->

            <aside class="sidebar">

                <!-- Logo -->

                <div class="sidebar-header">

                    <img src="~/images/company-logo.png"
                         class="sidebar-logo"
                         alt="AI Enterprise" />

                    <div>

                        <h4>AI Enterprise</h4>

                        <span>Command Center</span>

                    </div>

                </div>

               
                <!-- Navigation -->

                <nav class="sidebar-nav">

                    <div class="menu-title">

                        MAIN

                    </div>

                    <a asp-controller="Dashboard"
                       asp-action="Index"
                   class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Dashboard" ? "active" : "")">

                        <i class="bi bi-speedometer2"></i>

                        <span>Dashboard</span>

                    </a>

                @if (User.IsInRole("Admin") ||
                                User.IsInRole("IT Admin") || User.IsInRole("HR Manager"))
                    {
                        <a asp-controller="Employee"
                           asp-action="Index"
                       class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Employee" ? "active" : "")">

                            <i class="bi bi-people"></i>

                            <span>Employees</span>

                        </a>
                    }
                    @if (User.IsInRole("Admin") )
                    {
                        <a asp-controller="User"
                           asp-action="Index"
                       class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "User" ? "active" : "")">

                            <i class="bi bi-person-gear"></i>

                            <span>User Management</span>

                        </a>
                    }

                    @if (User.IsInRole("Admin") ||
                                        User.IsInRole("IT Admin"))
                    {
                        <a asp-controller="Asset"
                           asp-action="Index"
                       class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Asset" ? "active" : "")">

                            <i class="bi bi-laptop"></i>

                            <span>Assets</span>

                        </a>
                    }

                    @if (User.IsInRole("Admin") ||
                                        User.IsInRole("IT Admin") ||
                                User.IsInRole("Employee") || User.IsInRole("HR Manager"))
                    {
                        <a asp-controller="ServiceDesk"
                           asp-action="Index"
                       class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "ServiceDesk" ? "active" : "")">

                            <i class="bi bi-headset"></i>

                            <span>Service Desk</span>

                        </a>
                    }

                    @if (User.IsInRole("Admin") ||
                                        User.IsInRole("IT Admin"))
                    {
                        <a asp-controller="Project"
                           asp-action="Index"
                       class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Project" ? "active" : "")">

                            <i class="bi bi-kanban"></i>

                            <span>Projects</span>

                        </a>
                    }
                @if (User.IsInRole("Admin") ||
                                User.IsInRole("IT Admin") || User.IsInRole("HR Manager"))
                {
                        <a asp-controller="Report"
                           asp-action="Index"
                       class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Report" ? "active" : "")">

                            <i class="bi bi-bar-chart"></i>

                            <span>Reports</span>

                        </a>
                    }

                    <div class="menu-title mt-4">

                        AI

                    </div>

                    <a href="#"
                       id="openAI"
                       class="nav-link">

                        <i class="bi bi-robot"></i>

                        <span>AI Assistant</span>

                        <span class="badge bg-primary ms-auto">

                            NEW

                        </span>

                    </a>

                </nav>

                <!-- Bottom Profile -->

            <div class="sidebar-footer">

                <div class="profile-card">

                    <div class="profile-avatar">

                        <i class="bi bi-person-fill"></i>

                    </div>

                    <div class="profile-info">

                        <h6>

                            @currentUser?.FirstName @currentUser?.LastName

                        </h6>

                        <small>

                            @(User.IsInRole("Admin") ? "Administrator" :
                                                        User.IsInRole("HR Manager") ? "HR Manager" :
                                                        User.IsInRole("IT Admin") ? "IT Administrator" :
                                                        User.IsInRole("Employee") ? "Employee" :"Employee")

                        </small>

                        <div class="online">

                            <span class="dot"></span>

                            Online

                        </div>

                    </div>

                </div>

                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post"
                      class="mt-3">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="logout-btn">

                        <i class="bi bi-box-arrow-right"></i>

                        Logout

                    </button>

                </form>

            </div>

            </aside>

            <!-- ===================== -->
            <!-- Main -->
            <!-- ===================== -->

            <main class="main-wrapper">

        <!-- Main Content -->
                <div class="content-wrapper">

                <!-- ===================== -->
                <!-- Top Navigation -->
                <!-- ===================== -->

                <header class="topbar">

                    <div class="topbar-left">

                        <button id="sidebarToggle"
                                class="icon-btn">

                            <i class="bi bi-list"></i>

                        </button>

                        <div>

                            <h3 class="page-title">

                                @ViewData["Title"]

                            </h3>

                            

                        </div>

                    </div>


                    


                    <div class="topbar-right">

                        <!-- Dark Mode -->

                        <button id="themeToggle" class="icon-btn">

                            <i class="bi bi-moon-stars"></i>

                        </button>


                        <!-- AI -->

                        <button class="icon-btn"
                                id="topAI">

                            <i class="bi bi-robot"></i>

                        </button>


                        <!-- Notification -->

                        <div class="dropdown">

                            <button class="icon-btn position-relative"
                                    data-bs-toggle="dropdown">

                                <i class="bi bi-bell"></i>

                                <span class="notification-dot">

                                    @await Component.InvokeAsync("Notification")

                                </span>

                            </button>

                            <div class="dropdown-menu dropdown-menu-end notification-panel">

                                <div class="notification-header">

                                    Notifications

                                </div>

                                @await Component.InvokeAsync("NotificationList")

                            </div>

                        </div>


                        <!-- Profile -->

                        <div class="dropdown">

                            <button class="profile-btn"
                                    data-bs-toggle="dropdown">

                                <div class="profile-circle">

                                    @currentUser?.FirstName?[0]

                                </div>

                                <div class="profile-text">

                                    <strong>

                                        @currentUser?.FirstName

                                    </strong>

                                    <small>

                                        @(User.IsInRole("Admin")
                                                                                ? "Administrator"
                                                                                : User.IsInRole("HR Manager")
                                                                                ? "HR Manager"
                                                                                : User.IsInRole("IT Admin")
                                                                                ? "IT Administrator"
                                                                                : "Employee")

                                    </small>

                                </div>

                                <i class="bi bi-chevron-down"></i>

                            </button>


                            <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0">

                                <li>

                                    <a asp-controller="Profile"
                                       asp-action="Index"
                                       class="dropdown-item">

                                        <i class="bi bi-person me-2"></i>

                                        My Profile

                                    </a>

                                </li>

                                <li>

                                    <a asp-controller="Account"
                                       asp-action="ChangePassword"
                                       class="dropdown-item">

                                        <i class="bi bi-key me-2"></i>

                                        Change Password

                                    </a>

                                </li>

                                <li>

                                    <hr class="dropdown-divider">

                                </li>

                                <li>

                                    <form asp-controller="Account"
                                          asp-action="Logout"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="dropdown-item text-danger">

                                            <i class="bi bi-box-arrow-right me-2"></i>

                                            Logout

                                        </button>

                                    </form>

                                </li>

                            </ul>

                        </div>

                    </div>

                </header>

                <div class="page-content">

                    @RenderBody()

                </div>
                

           

                </div>

            </main>

        </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>


    @RenderSection("Scripts", required: false)
    
    <!-- Floating AI Button -->

    <div id="aiButton">

        <i class="bi bi-robot"></i>
        @* <img src="/images/ai.png" width="34"> *@

    </div>

    <!-- Chat Window -->

    <div id="chatWindow">

        <div class="chat-header">

            <div class="d-flex align-items-center">

                <div class="avatar me-2">
                    🤖
                </div>

                <div>

                    <strong>Enterprise AI</strong>

                    <br>

                    <small style="font-size:12px">

                        ● Online

                    </small>

                   
                </div>

            </div>

            <button id="closeChat"
                    class="btn btn-sm btn-light">

                ✕

            </button>

        </div>

        <div id="chatMessages">
        </div>

        <div class="chat-footer">

            <input id="message" type="text"
                   class="form-control"
                   placeholder="Type your message..." />

            <button id="sendBtn" class="send-btn">
                <i class="bi bi-send-fill"></i>
            </button>

                <button id="clearChat">Clear</button>

            

        </div>

    </div>

    <link rel="stylesheet" href="~/css/ai/chatbot.css" />

    <script src="~/js/ai/chatbot.js"></script>



    <script>

        const sidebarToggle = document.getElementById("sidebarToggle");

        const sidebar = document.querySelector(".sidebar");

        sidebarToggle?.addEventListener("click",()=>{

            sidebar.classList.toggle("collapsed");

        });

        document.getElementById("topAI")?.addEventListener("click",()=>{

            document.getElementById("aiButton").click();

        });

        document.getElementById("openAI")?.addEventListener("click",(e)=>{

            e.preventDefault();

            document.getElementById("aiButton").click();

        });

    </script>
    <script src="~/js/theme.js"></script>
</body>
</html>
<script>
    async function markAsRead(id) {

        await fetch('/Notification/MarkAsRead', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded'
            },
            body: 'id=' + id
        });

        document.getElementById('notification-' + id).remove();
    }

    async function deleteNotification(id) {

        await fetch('/Notification/Delete', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded'
            },
            body: 'id=' + id
        });

        document.getElementById('notification-' + id).remove();
    }
</script>