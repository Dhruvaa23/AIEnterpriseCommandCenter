

@model AIEnterpriseCommandCenter.Application.ViewModels.LoginViewModel

@{
    Layout = null;
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1">

    <title>AI Enterprise Command Center</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    <link rel="stylesheet"
          href="~/css/login.css"
          asp-append-version="true" />

</head>

<body>

    <div class="login-page">

        <!-- LEFT SIDE -->

        <div class="left-panel">

            <div class="grid-bg"></div>

            <div class="left-content">

                <img src="~/images/company-logo.png"
                     class="logo"
                     asp-append-version="true"
                     alt="Logo" />

                <div class="tagline">

                    <h1>
                        AI Enterprise
                        <br />
                        <span>Command Center</span>
                    </h1>

                    <p>

                        Secure Enterprise Platform powered by Artificial Intelligence.

                    </p>

                    <div class="line"></div>

                </div>

            </div>

        </div>

        <!-- RIGHT SIDE -->

        <div class="right-panel">

            <div class="login-box">

               

                <div class="welcome">

                    Welcome Back 👋

                </div>

                <h2>

                    Sign in to your account

                </h2>

                <p class="login-text">

                    Access AI Enterprise Command Center securely.

                </p>

               

                <form asp-action="Login"
                      asp-controller="Account"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           asp-for="ReturnUrl" />

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3"></div>

                    <!-- Email -->

                    <div class="form-group">

                        <label asp-for="Email"></label>

                        <input asp-for="Email"
                               class="form-control"
                               placeholder="Enter your email address" />

                        <span asp-validation-for="Email"
                              class="text-danger"></span>

                    </div>

                    <!-- Password -->

                    <div class="form-group">

                        <label asp-for="Password"></label>

                        <input asp-for="Password"
                               class="form-control"
                               placeholder="Enter password" />

                        <span asp-validation-for="Password"
                              class="text-danger"></span>

                    </div>

                    <!-- Remember -->

                    <div class="options">

                        <div>

                            <input asp-for="RememberMe" />

                            <label asp-for="RememberMe"></label>

                        </div>

                        <a asp-action="ForgotPassword"
                           asp-controller="Account">

                            Forgot Password?

                        </a>

                    </div>

                    <button type="submit"
                            class="btn-login">

                        <i class="bi bi-box-arrow-in-right"></i>

                        Login

                    </button>

                </form>

               
                <div class="footer">

                    AI Enterprise Command Center

                    <br />

                    Version 1.0

                </div>

            </div>

        </div>

    </div>

    <partial name="_ValidationScriptsPartial" />

</body>

</html>