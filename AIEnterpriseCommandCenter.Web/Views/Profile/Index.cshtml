@model AIEnterpriseCommandCenter.Application.DTOs.Account.ProfileDto

@{
    ViewData["Title"] = "My Profile";
}

<div class="container-fluid">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            <i class="bi bi-check-circle-fill me-2"></i>

            @TempData["Success"]

            <button class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    <div class="row">

        <!-- LEFT CARD -->

        <div class="col-lg-4">

            <div class="card border-0 shadow rounded-4">

                <div class="card-body text-center p-5">

                    @if (string.IsNullOrEmpty(Model.ProfilePicture))
                    {
                        <img src="https://ui-avatars.com/api/?name=@Model.FirstName+@Model.LastName&background=0D6EFD&color=fff&size=256"
                             class="rounded-circle border shadow"
                             width="160"
                             height="160" />
                    }
                    else
                    {
                        <img src="@Model.ProfilePicture"
                             class="rounded-circle border shadow"
                             width="160"
                             height="160" />
                    }

                    <h3 class="fw-bold mt-4">

                        @Model.FirstName @Model.LastName

                    </h3>

                    <p class="text-muted mb-2">

                        @Model.Designation

                    </p>

                    <span class="badge bg-primary fs-6">

                        @Model.Role

                    </span>

                    <hr />

                    <div class="row text-start">

                        <div class="col-6">

                            <small class="text-muted">

                                Employee Code

                            </small>

                            <div class="fw-semibold">

                                @Model.EmployeeCode

                            </div>

                        </div>

                        <div class="col-6">

                            <small class="text-muted">

                                Status

                            </small>

                            <div>

                                @if (Model.IsActive)
                                {
                                    <span class="badge bg-success">

                                        Active

                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">

                                        Inactive

                                    </span>
                                }

                            </div>

                        </div>

                    </div>

                    <hr />

                    <small class="text-muted">

                        Member Since

                    </small>

                    <div class="fw-semibold">

                        @Model.CreatedOn.ToString("dd MMM yyyy")

                    </div>

                </div>

            </div>

        </div>

        <!-- RIGHT CARD -->

        <div class="col-lg-8">

            <div class="card border-0 shadow rounded-4">

                <div class="card-header bg-white">

                    <h4 class="fw-bold mb-0">

                        <i class="bi bi-person-lines-fill me-2"></i>

                        Personal Information

                    </h4>

                </div>

                <div class="card-body p-4">

                    <form asp-action="Index" method="post">

                        <input asp-for="Id" type="hidden" />

                        <div class="row">

                            <div class="col-md-6 mb-4">

                                <label class="form-label fw-semibold">

                                    First Name

                                </label>

                                <input asp-for="FirstName"
                                       class="form-control" />

                            </div>

                            <div class="col-md-6 mb-4">

                                <label class="form-label fw-semibold">

                                    Last Name

                                </label>

                                <input asp-for="LastName"
                                       class="form-control" />

                            </div>

                        </div>

                        <div class="row">

                            <div class="col-md-6 mb-4">

                                <label class="form-label fw-semibold">

                                    Email

                                </label>

                                <input asp-for="Email"
                                       class="form-control"
                                       readonly />

                            </div>

                            <div class="col-md-6 mb-4">

                                <label class="form-label fw-semibold">

                                    Employee Code

                                </label>

                                <input asp-for="EmployeeCode"
                                       class="form-control"
                                       readonly />

                            </div>

                        </div>

                        <div class="row">

                            <div class="col-md-6 mb-4">

                                <label class="form-label fw-semibold">

                                    Department

                                </label>

                                <input asp-for="Department"
                                       class="form-control" />

                            </div>

                            <div class="col-md-6 mb-4">

                                <label class="form-label fw-semibold">

                                    Designation

                                </label>

                                <input asp-for="Designation"
                                       class="form-control" />

                            </div>

                        </div>

                        <div class="row">

                            <div class="col-md-6 mb-4">

                                <label class="form-label fw-semibold">

                                    Role

                                </label>

                                <input asp-for="Role"
                                       class="form-control"
                                       readonly />

                            </div>

                            <div class="col-md-6 mb-4">

                                <label class="form-label fw-semibold">

                                    Account Status

                                </label>

                                <input class="form-control"
                                       readonly
                                       value="@(Model.IsActive ? "Active" : "Inactive")" />

                            </div>

                        </div>

                        <hr />

                        <div class="d-flex justify-content-end">

                            <a asp-controller="Account"
                               asp-action="ChangePassword"
                               class="btn btn-outline-warning me-2">

                                <i class="bi bi-key-fill me-2"></i>

                                Change Password

                            </a>

                            <button class="btn btn-primary">

                                <i class="bi bi-check-circle me-2"></i>

                                Save Changes

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}