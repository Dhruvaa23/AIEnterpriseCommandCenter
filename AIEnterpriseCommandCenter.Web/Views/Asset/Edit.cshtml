@model AIEnterpriseCommandCenter.Application.DTOs.Asset.UpdateAssetDto

@{
    ViewData["Title"] = "Edit Asset";
}

<div class="card shadow border-0">

    <div class="card-header bg-warning">

        <h4 class="mb-0">
            <i class="bi bi-pencil-square"></i>
            Edit Asset
        </h4>

    </div>

    <div class="card-body">

        <form asp-action="Edit" method="post">

            @Html.AntiForgeryToken()

            <input asp-for="Id" type="hidden" />

            <div class="row">

                <div class="col-md-6 mb-3">
                    <label asp-for="AssetCode"></label>
                    <input asp-for="AssetCode" class="form-control" />
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="AssetName"></label>
                    <input asp-for="AssetName" class="form-control" />
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Category"></label>
                    <input asp-for="Category" class="form-control" />
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Brand"></label>
                    <input asp-for="Brand" class="form-control" />
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Model"></label>
                    <input asp-for="Model" class="form-control" />
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="PurchaseDate"></label>
                    <input asp-for="PurchaseDate"
                           type="date"
                           class="form-control" />
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="PurchasePrice"></label>
                    <input asp-for="PurchasePrice"
                           class="form-control" />
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Status"></label>

                    <select asp-for="Status" class="form-select">

                        <option>Available</option>

                        <option>Assigned</option>

                        <option>Under Repair</option>

                    </select>

                </div>

            </div>

            <button class="btn btn-warning">

                <i class="bi bi-check-circle"></i>

                Update Asset

            </button>

            <a asp-action="Index"
               class="btn btn-secondary">

                Cancel

            </a>

        </form>

    </div>

</div>