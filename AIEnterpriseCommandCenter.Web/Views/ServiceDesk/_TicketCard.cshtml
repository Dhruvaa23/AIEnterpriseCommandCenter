@model AIEnterpriseCommandCenter.Application.DTOs.ServiceDesk.TicketDto

@{
    var priorityColor = Model.Priority switch
    {
        AIEnterpriseCommandCenter.Domain.Enums.TicketPriority.Low => "#6c757d",
        AIEnterpriseCommandCenter.Domain.Enums.TicketPriority.Medium => "#3b82f6",
        AIEnterpriseCommandCenter.Domain.Enums.TicketPriority.High => "#f59e0b",
        AIEnterpriseCommandCenter.Domain.Enums.TicketPriority.Critical => "#ef4444",
        _ => "#6c757d"
    };

    var statusColor = Model.Status switch
    {
        AIEnterpriseCommandCenter.Domain.Enums.TicketStatus.Open => "#22c55e",
        AIEnterpriseCommandCenter.Domain.Enums.TicketStatus.InProgress => "#f59e0b",
        AIEnterpriseCommandCenter.Domain.Enums.TicketStatus.Resolved => "#3b82f6",
        AIEnterpriseCommandCenter.Domain.Enums.TicketStatus.Closed => "#6b7280",
        _ => "#22c55e"
    };
}

<div class="ticket-card mb-3"
     data-id="@Model.Id">

    <div class="d-flex justify-content-between align-items-start">

        <div>

            <div class="ticket-number">
                @Model.TicketNumber
            </div>

            <h5 class="ticket-title mt-2">
                @Model.Title
            </h5>

            <div class="ticket-meta mt-2">

                <span class="me-3">
                    <i class="bi bi-tag"></i>
                    @Model.Category
                </span>

                <span>
                    •
                    @(Model.AIConfidence)% AI
                </span>

            </div>

        </div>

        <span class="priority-badge"
              style="background:@priorityColor">

            @Model.Priority

        </span>

    </div>

</div>

<style>

    .ticket-card{

        background:#16213a;

        border:1px solid #2b3d63;

        border-radius:18px;

        padding:15px;

        cursor:pointer;

        transition:.25s;

    }

    .ticket-card:hover{

        transform:translateY(-3px);

        border-color:#44d3c8;

        box-shadow:0 0 20px rgba(68,211,200,.25);

    }

    .ticket-number{

        color:#7aa7ff;

        font-size:13px;

        font-weight:600;

    }

    .ticket-title{

        color:white;

        font-weight:700;

    }

    .ticket-meta{

        color:#73f6df;

        font-size:14px;

    }

    .priority-badge{

        color:white;

        padding:6px 14px;

        border-radius:25px;

        font-size:12px;

        font-weight:700;

    }

</style>