@model IEnumerable<AIEnterpriseCommandCenter.Application.DTOs.Asset.AssetDto>

@{
    ViewData["Title"] = "Asset Report";
}

<div class="container-fluid py-4">

    <!-- Header -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold mb-1">
                <i class="bi bi-laptop text-primary me-2"></i>
                Asset Report
            </h2>

            <p class="text-muted">
                Company asset information preview before exporting.
            </p>

        </div>

        <div>

            <a asp-action="ExportAssetPdf"
               class="btn btn-danger rounded-pill me-2">

                <i class="bi bi-file-earmark-pdf"></i>

                PDF

            </a>

            <a asp-action="ExportAssetExcel"
               class="btn btn-success rounded-pill me-2">

                <i class="bi bi-file-earmark-excel"></i>

                Excel

            </a>

            <a asp-action="Index"
               class="btn btn-secondary rounded-pill">

                Back

            </a>

        </div>

    </div>

    <!-- Summary -->

    <div class="row mb-4">

        <div class="col-md-3">

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-body text-center">

                    <h2 class="fw-bold text-primary">

                        @Model.Count()

                    </h2>

                    <div class="text-muted">

                        Total Assets

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- Table -->

    <div class="card border-0 shadow rounded-4">

        <div class="card-header bg-white">

            <div class="row align-items-center">

                <div class="col-md-6">

                    <h5 class="fw-bold mb-0">

                        Asset List

                    </h5>

                </div>

                <div class="col-md-6 text-end">

                    <input type="text"
                           id="searchAsset"
                           class="form-control"
                           placeholder="Search asset..." />

                </div>

            </div>

        </div>

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0"
                   id="assetTable">

                <thead class="table-light">

                    <tr>

                        <th>Code</th>
                        <th>Asset</th>
                        <th>Category</th>
                        <th>Brand</th>
                        <th>Status</th>
                        <th>Assigned To</th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>

                                <span class="badge bg-dark">

                                    @item.AssetCode

                                </span>

                            </td>

                            <td>

                                <strong>@item.AssetName</strong>

                            </td>

                            <td>

                                @item.Category

                            </td>

                            <td>

                                @item.Brand

                            </td>

                            <td>

                                @if (item.Status == "Available")
                                {
                                    <span class="badge bg-success">

                                        Available

                                    </span>
                                }
                                else if (item.Status == "Assigned")
                                {
                                    <span class="badge bg-primary">

                                        Assigned

                                    </span>
                                }
                                else if (item.Status == "Maintenance")
                                {
                                    <span class="badge bg-warning text-dark">

                                        Maintenance

                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">

                                        @item.Status

                                    </span>
                                }

                        </td>

                        <td>

                            @(string.IsNullOrEmpty(item.EmployeeName)
                                                        ? "-"
                                                        : item.EmployeeName)

                        </td>

                        </tr>
                                        }

                </tbody>

            </table>

        </div>

    </div>

</div>

@section Scripts {

    <script>

        document.getElementById("searchAsset").addEventListener("keyup", function () {

            var value = this.value.toLowerCase();

            document.querySelectorAll("#assetTable tbody tr").forEach(function (row) {

                row.style.display =
                    row.innerText.toLowerCase().includes(value)
                        ? ""
                        : "none";

            });

        });

    </script>

}

<style>

    .table tbody tr:hover {
        background: #f8f9fa;
    }

    .badge {
        font-size: .85rem;
    }

    .card {
        border-radius: 20px;
    }

</style>