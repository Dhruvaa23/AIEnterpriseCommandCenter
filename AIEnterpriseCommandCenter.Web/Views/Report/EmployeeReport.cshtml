@model IEnumerable<AIEnterpriseCommandCenter.Application.DTOs.Employee.EmployeeDto>

@{
    ViewData["Title"] = "Employee Report";
}

<div class="container-fluid py-4">

    <!-- Header -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold mb-1">
                <i class="bi bi-people-fill text-primary me-2"></i>
                Employee Report
            </h2>

            <p class="text-muted">
                Employee information preview before exporting.
            </p>

        </div>

        <div>

            <a asp-action="ExportEmployeePdf"
               class="btn btn-danger rounded-pill me-2">

                <i class="bi bi-file-earmark-pdf"></i>

                PDF

            </a>

            <a asp-action="ExportEmployeeExcel"
               class="btn btn-success rounded-pill me-2">

                <i class="bi bi-file-earmark-excel"></i>

                Excel

            </a>

            <a asp-action="Index"
               class="btn btn-secondary rounded-pill">

                Back

            </a>

        </div>

    </div>

    <!-- Summary -->

    <div class="row mb-4">

        <div class="col-md-3">

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-body text-center">

                    <h2 class="fw-bold text-primary">

                        @Model.Count()

                    </h2>

                    <div class="text-muted">

                        Total Employees

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- Table -->

    <div class="card border-0 shadow rounded-4">

        <div class="card-header bg-white">

            <div class="row">

                <div class="col-md-6">

                    <h5 class="fw-bold mb-0">

                        Employee List

                    </h5>

                </div>

                <div class="col-md-6 text-end">

                    <input type="text"
                           id="searchEmployee"
                           class="form-control"
                           placeholder="Search employee..." />

                </div>

            </div>

        </div>

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0"
                   id="employeeTable">

                <thead class="table-light">

                    <tr>

                        <th>Code</th>

                        <th>Name</th>

                        <th>Department</th>

                        <th>Designation</th>

                        <th>Email</th>

                        <th>Phone</th>

                        <th>Status</th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>

                                <span class="badge bg-dark">

                                    @item.EmployeeCode

                                </span>

                            </td>

                            <td>

                                <strong>@item.FullName</strong>

                            </td>

                            <td>

                                @item.Department

                            </td>

                            <td>

                                @item.Designation

                            </td>

                            <td>

                                @item.Email

                            </td>

                            <td>

                                @item.PhoneNumber

                            </td>

                            <td>

                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">

                                        Active

                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">

                                        Inactive

                                    </span>
                                }

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

@section Scripts {

    <script>

        document.getElementById("searchEmployee").addEventListener("keyup", function () {

            var value = this.value.toLowerCase();

            document.querySelectorAll("#employeeTable tbody tr").forEach(function (row) {

                row.style.display =
                    row.innerText.toLowerCase().includes(value)
                        ? ""
                        : "none";

            });

        });

    </script>

}

<style>

    .table tbody tr:hover {
        background: #f8f9fa;
    }

    .badge {
        font-size: .85rem;
    }

    .card {
        border-radius: 20px;
    }

</style>